# Секрет подписи сессионной куки, не короче 32 символов
SESSION_KEY=change-me-to-a-long-random-secret-string
# Строка подключения к PostgreSQL. Если её нет, приложение берёт встроенный PGlite
# в каталоге PGLITE_DATA_DIR (без каталога — в памяти)
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite
# DSN коллектора ошибок (Bugsink, протокол Sentry), необязательно
SENTRY_DSN=
# Язык интерфейса
LOCALE=ru
