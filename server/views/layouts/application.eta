<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= it.t('appName') %></title>
    <link href="<%= it.assetPath('main.css') %>" rel="stylesheet">
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">
    <nav class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-4 py-3">
        <a class="text-lg font-semibold text-blue-700" href="<%= it.route('root') %>"><%= it.t('appName') %></a>
        <ul class="flex flex-wrap items-center gap-4">
          <li><a class="hover:text-blue-700" href="<%= it.route('users') %>"><%= it.t('layouts.application.users') %></a></li>
          <% if (it.isAuthenticated) { %>
          <li><a class="hover:text-blue-700" href="<%= it.route('statuses') %>"><%= it.t('layouts.application.statuses') %></a></li>
          <li><a class="hover:text-blue-700" href="<%= it.route('labels') %>"><%= it.t('layouts.application.labels') %></a></li>
          <li><a class="hover:text-blue-700" href="<%= it.route('tasks') %>"><%= it.t('layouts.application.tasks') %></a></li>
          <% } %>
        </ul>
        <ul class="ml-auto flex items-center gap-4">
          <% if (it.isAuthenticated) { %>
          <li>
            <%~ include("../mixins/buttonTo", {
              action: it.route('session'),
              method: 'delete',
              value: it.t('layouts.application.signOut'),
              class: 'cursor-pointer hover:text-blue-700',
            }) %>
          </li>
          <% } else { %>
          <li><a class="hover:text-blue-700" href="<%= it.route('newSession') %>"><%= it.t('layouts.application.signIn') %></a></li>
          <li><a class="hover:text-blue-700" href="<%= it.route('newUser') %>"><%= it.t('layouts.application.signUp') %></a></li>
          <% } %>
        </ul>
      </div>
    </nav>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6">
      <% Object.entries(it.flash ?? {}).forEach(([type, messages]) => { %>
        <% messages.forEach((message) => { %>
        <div class="mb-4 rounded border px-4 py-3 <%= it.alertClass(type) %>" role="alert"><%= message %></div>
        <% }) %>
      <% }) %>
      <% if (it.header) { %>
      <h1 class="mb-6 text-3xl font-semibold"><%= it.header %></h1>
      <% } %>
      <%~ it.body %>
    </main>
    <footer class="border-t border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-4 text-sm text-gray-500">
        <a class="hover:text-blue-700" target="_blank" href="https://ru.hexlet.io">Hexlet</a>
      </div>
    </footer>
  </body>
</html>
